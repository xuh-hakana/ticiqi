/* ===========================================================================
   提词器 · 排版重排层（ticiqi 独立项目 · 2026-11-06）
   ---------------------------------------------------------------------------
   这是干什么的：把「命令方块整页靠 CSS 藏掉大半、只露一块」的残块结构，
   重排成提词器自己的固定骨架；并给规格里还没做的功能留好固定位置（槽位）。

   三条硬约束：
   1. 不改 styles.css / theme.css / night.css 任何一行，本文件后加载、只做覆盖。
   2. index.html 里 147 个原有 id 一个不删不改名，老功能逐条保留。
   3. 槽位是「开发时定死的位置」，运行时不自动排版（她原话：软件本身不能排版，应该固定）。
      所有槽位默认 disabled + 标注「未开放」，不伪装成可用按钮。

   骨架（自上而下，全部 flex:0 0 auto，只有 prompt-body 吃剩余高度）：
     tc-topbar   自有顶栏：品牌 / 三视图 / 皮肤 / 白天夜晚 / 状态灯
     prompt-head 原有标题区（保留）
     tc-groups   三大类分组条 + 含失效开关 + 聚合状态
     prompt-stats / prompt-pending（原有，保留）
     prompt-body 左：六段结构槽 + 需求列表；右：详情
     tc-dock     底栏：同步待办 / 读取报告 / 插件 / 多项目 / 版本快照
   =========================================================================== */

/* ---------- 1 提词器自有顶栏 ---------- */
.tc-topbar {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 44px;
  padding: 7px 20px 7px 22px;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
  -webkit-app-region: drag;
}
.tc-topbar button, .tc-topbar input { -webkit-app-region: no-drag; }
/* mac 交通灯：原来由 prompt-head 让位，改由真正的第一行顶栏让位 */
html[data-app="prompter"][data-platform="darwin"] .tc-topbar {
  padding-top: 30px;
  padding-left: 94px;
}
html[data-app="prompter"][data-platform="darwin"] .prompt-head {
  padding-top: 12px;
  padding-left: 26px;
}

.tc-brand { display: flex; align-items: baseline; gap: 8px; white-space: nowrap; }
.tc-brand strong { font-size: 13px; letter-spacing: .04em; color: var(--ink); }
.tc-brand small {
  font-family: var(--mono); font-size: 9px; letter-spacing: .16em;
  color: var(--faint);
}

/* 三视图切换：当前只有「文字」可用，另两个是固定预留位 */
.tc-views { display: flex; align-items: center; gap: 4px; }
.tc-view-btn {
  border: 1px solid transparent; border-radius: 8px;
  padding: 5px 11px; font: inherit; font-size: 11px;
  color: var(--muted); background: transparent; cursor: pointer;
  transition: color .18s, background .18s, border-color .18s;
}
.tc-view-btn:hover:not(:disabled) { color: var(--ink); background: var(--surface-2); }
.tc-view-btn.is-active {
  color: var(--accent-dark); background: var(--accent-soft);
  border-color: var(--line-strong); font-weight: 600;
}
.tc-view-btn:disabled { opacity: .78; cursor: not-allowed; }

.tc-topbar-spacer { flex: 1; }
.tc-topbar-actions { display: flex; align-items: center; gap: 7px; }
.tc-btn {
  display: inline-flex; align-items: center; gap: 6px;
  border: 1px solid var(--line); border-radius: 8px;
  padding: 5px 10px; font: inherit; font-size: 11px;
  color: var(--ink-soft); background: var(--surface-2); cursor: pointer;
  transition: color .18s, border-color .18s, background .18s;
}
.tc-btn:hover { color: var(--ink); border-color: var(--line-strong); }
.tc-btn .icon { width: 13px; height: 13px; }
.tc-btn.is-on { color: var(--accent-dark); border-color: var(--line-strong); background: var(--accent-soft); }

/* 顶栏状态灯（文件监听 / 读取报告 / 同步）都是预留位 */
.tc-lights { display: flex; align-items: center; gap: 9px; }
.tc-light {
  display: inline-flex; align-items: center; gap: 5px;
  font-family: var(--mono); font-size: 9px; color: var(--faint);
  white-space: nowrap;
}
.tc-light i {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--line-strong); display: inline-block;
}

/* ---------- 2 三大类分组条 ---------- */
.tc-groups {
  flex: 0 0 auto;
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  padding: 8px 22px;
  border-bottom: 1px solid var(--line);
  background: var(--surface-2);
}
.tc-groups-label {
  font-family: var(--mono); font-size: 9px; letter-spacing: .14em;
  color: var(--faint); margin-right: 4px;
}
.tc-group-btn {
  border: 1px solid transparent; border-radius: 7px;
  padding: 4px 10px; font: inherit; font-size: 11px;
  color: var(--muted); background: transparent; cursor: pointer;
}
.tc-group-btn.is-active {
  color: var(--accent-dark); background: var(--accent-soft);
  border-color: var(--line-strong); font-weight: 600;
}
.tc-group-btn:disabled { opacity: .78; cursor: not-allowed; }
/* 已完成区下面三个子标签页：固定位置，将来填功能 */
.tc-subtabs {
  display: inline-flex; gap: 3px; padding: 2px 4px;
  border: 1px dashed var(--line-strong); border-radius: 7px;
}
.tc-subtab {
  font-family: var(--mono); font-size: 9px; color: var(--faint);
  padding: 2px 6px; border-radius: 4px; background: var(--surface-3);
}
.tc-groups-tools { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.tc-switch {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 10px; color: var(--faint); white-space: nowrap;
}
.tc-switch i {
  width: 22px; height: 12px; border-radius: 7px;
  background: var(--line); border: 1px solid var(--line-strong);
  display: inline-block; position: relative;
}
.tc-switch i::after {
  content: ""; position: absolute; left: 2px; top: 1px;
  width: 8px; height: 8px; border-radius: 50%; background: var(--faint);
}

/* ---------- 3 六段结构槽（左栏，需求列表上方） ---------- */
.tc-segments {
  flex: 0 0 auto;
  display: flex; flex-wrap: wrap; gap: 4px;
  padding: 9px 12px 10px;
  border-bottom: 1px solid var(--line);
}
.tc-segments-head {
  flex: 0 0 100%; display: flex; align-items: center; gap: 6px;
  font-family: var(--mono); font-size: 9px; letter-spacing: .12em;
  color: var(--faint); margin-bottom: 3px;
}
.tc-seg {
  font-size: 10px; padding: 3px 8px; border-radius: 6px;
  color: var(--muted); background: var(--surface-2);
  border: 1px solid var(--line);
}
.tc-seg-note {
  flex: 0 0 100%; font-size: 9px; color: var(--faint); margin-top: 3px;
}
/* 超 7000 token 整列标红：固定在左栏底部的一条预留提示位 */
.tc-oversize {
  flex: 0 0 auto;
  display: none; align-items: center; gap: 6px;
  padding: 6px 12px; font-size: 10px;
  color: var(--red); background: var(--red-soft);
  border-top: 1px solid var(--line-strong);
}
.tc-oversize.is-shown { display: flex; }

/* ---------- 4 详情区槽位（右栏，详情下方） ---------- */
.tc-detail-slots {
  flex: 0 0 auto;
  display: flex; flex-wrap: wrap; gap: 5px;
  padding: 9px 22px 10px;
  border-top: 1px solid var(--line);
  background: var(--surface);
}
.tc-detail-slots .tc-groups-label { flex: 0 0 100%; }

/* ---------- 5 底栏 dock ---------- */
.tc-dock {
  flex: 0 0 auto;
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  padding: 7px 20px;
  border-top: 1px solid var(--line);
  background: var(--surface);
  min-height: 36px;
}
.tc-dock-label {
  font-family: var(--mono); font-size: 9px; letter-spacing: .12em;
  color: var(--faint); margin-right: 3px;
}
.tc-dock-slot {
  font-size: 10px; padding: 3px 8px; border-radius: 6px;
  color: var(--faint); background: var(--surface-2);
  border: 1px dashed var(--line-strong);
  white-space: nowrap;
}
.tc-dock-slot.is-live {
  color: var(--accent-dark); background: var(--accent-soft);
  border-style: solid; cursor: pointer;
}
.tc-dock-ver {
  margin-left: auto; font-family: var(--mono); font-size: 9px;
  color: var(--faint); white-space: nowrap;
}

/* ---------- 6 预留位统一标记 ---------- */
/* 槽位只标「未开放」，不做成能点的假功能；关掉标记时整块隐藏，界面更干净 */
.tc-slot-tag {
  font-family: var(--mono); font-size: 8px; letter-spacing: .06em;
  color: var(--faint); opacity: .82;
}
html[data-tc-slots="off"] .tc-slot,
html[data-tc-slots="off"] .tc-slot-tag { display: none !important; }
html[data-tc-slots="off"] .tc-oversize { display: none !important; }

/* ---------- 7 统计条 / 标题区收紧（原样式偏松，重排后收齐） ---------- */
html[data-app="prompter"] .prompt-head { padding: 12px 22px 10px; gap: 12px; }
html[data-app="prompter"] .prompt-head-copy h1 { font-size: 17px; }
html[data-app="prompter"] .prompt-head-copy p { font-size: 10px; line-height: 1.5; }
html[data-app="prompter"] .prompt-stats { padding: 7px 22px; gap: 16px; }
html[data-app="prompter"] .prompt-body { grid-template-columns: 300px minmax(0, 1fr); }

/* ---------- 8 皮肤三选一弹层（自绘，不用 prompt/confirm/alert） ---------- */
.skin-overlay {
  position: fixed; inset: 0; z-index: 125;
  display: grid; place-items: center;
  background: rgba(10, 14, 26, .46);
}
.skin-overlay[hidden] { display: none !important; }
.skin-panel {
  width: min(560px, 92vw);
  border-radius: 16px; padding: 18px;
  background: var(--card, #fff); color: var(--text, var(--ink));
  box-shadow: 0 24px 70px rgba(0, 0, 0, .28);
  border: 1px solid var(--line);
}
.skin-panel-head { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
.skin-panel-head h2 { margin: 0; font-size: 15px; color: var(--ink); }
.skin-panel-head .ghost-btn { margin-left: auto; }
.skin-panel-note {
  font-size: 11px; color: var(--muted); margin: 0 0 14px; line-height: 1.6;
}
.skin-options { display: grid; gap: 9px; }
.skin-option {
  display: flex; align-items: center; gap: 12px; text-align: left;
  border: 1px solid var(--line); border-radius: 11px;
  padding: 12px 14px; background: var(--surface-2);
  color: var(--ink); font: inherit; cursor: pointer;
  transition: border-color .18s, background .18s, transform .18s;
}
.skin-option:hover { border-color: var(--line-strong); transform: translateY(-1px); }
.skin-option.is-active { border-color: var(--accent); background: var(--accent-soft); }
.skin-swatch {
  flex: 0 0 auto; width: 44px; height: 32px; border-radius: 7px;
  border: 1px solid var(--line-strong);
}
.skin-swatch.s-none { background: linear-gradient(135deg, #f4f6fb 50%, #20242b 50%); }
.skin-swatch.s-nocturne { background: linear-gradient(135deg, #07060e 60%, #35e6cb 60%, #07060e 78%, #ff2e88 78%); }
.skin-swatch.s-cybercore { background: linear-gradient(135deg, #050914 40%, #00e5ff 40%, #050914 58%, #ff2e88 58%, #050914 76%, #ffe94d 76%); }
.skin-option-copy { flex: 1; min-width: 0; }
.skin-option-copy strong { display: block; font-size: 12px; margin-bottom: 3px; }
.skin-option-copy span { display: block; font-size: 10px; color: var(--muted); line-height: 1.5; }
.skin-check {
  flex: 0 0 auto; font-family: var(--mono); font-size: 10px;
  color: var(--accent-dark); opacity: 0;
}
.skin-option.is-active .skin-check { opacity: 1; }
.skin-panel-foot {
  margin-top: 13px; padding-top: 11px; border-top: 1px solid var(--line);
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  font-size: 10px; color: var(--faint);
}
.skin-panel-foot .tc-btn { margin-left: auto; }

/* ---------- 9 轻提示（≥2.5 秒或点击才关） ---------- */
.tc-toast {
  position: fixed; left: 50%; bottom: 26px; transform: translateX(-50%);
  z-index: 140; padding: 9px 17px; border-radius: 10px;
  background: var(--ink); color: var(--surface);
  font-size: 11px; cursor: pointer;
  box-shadow: 0 10px 30px rgba(0, 0, 0, .25);
}
.tc-toast[hidden] { display: none; }

/* ---------- 10 窄窗口兜底 ---------- */
@media (max-width: 900px) {
  .tc-topbar { flex-wrap: wrap; gap: 8px; }
  .tc-brand small, .tc-lights { display: none; }
  .tc-groups-tools { margin-left: 0; }
  html[data-app="prompter"] .prompt-body { grid-template-columns: 240px minmax(0, 1fr); }
}

/* 重排收尾：顶栏已经有「提词器」品牌，去掉从命令方块带来的重复装饰标签。
   只隐藏这一个 ::before 徽标，不动 h1 / 说明 / 任何功能。 */
html[data-app="prompter"] .prompt-head::before { display: none; }

/* ---------- 11 导入入口 + 卡片归类标签 + 详情归类块 ---------- */
.tc-slot-tag { /* 已有定义，本段不重复 */ }

/* 顶栏「导入需求」按钮：与「新建需求」并列，强调这是你要的入口 */
#promptImportBtn .icon { width: 14px; height: 14px; }

.prompt-card-tags {
  display: flex; flex-wrap: wrap; gap: 4px;
  margin: 2px 0 1px;
}
.pcat, .pseg {
  font-size: 9.5px; line-height: 1; padding: 3px 6px; border-radius: 5px;
  border: 1px solid var(--line); background: var(--surface-2); color: var(--muted);
  white-space: nowrap;
}
.pcat { font-weight: 600; }
/* 三大类配色：待办/想法/已完成/AI转正/失效 —— 用低饱和底色，不抢体检分 */
.cat-todo   { color: #2f6f4f; background: #e7f3ec; border-color: #bfe0cd; }
.cat-idea   { color: #7a5a12; background: #fbf0d8; border-color: #ecd6a6; }
.cat-done   { color: #3a5a8a; background: #e7eefb; border-color: #c2d4f2; }
.cat-ai_done{ color: #7a3a8a; background: #f3e9fb; border-color: #e0c9f2; }
.cat-invalid{ color: #8a3a3a; background: #fbeaea; border-color: #f2c2c2; }

/* 详情里的归类块 */
.prompt-class {
  padding: 9px 12px 11px; margin: 0 0 4px;
  border: 1px solid var(--line); border-radius: 10px;
  background: var(--surface-2);
}
.prompt-class .field-label { display: block; margin-bottom: 7px; }
.class-row { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
.class-select {
  font: inherit; font-size: 11px; padding: 4px 7px; border-radius: 7px;
  border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink);
  cursor: pointer;
}
.class-coord {
  font-family: var(--mono); font-size: 10px; color: var(--muted);
  display: inline-flex; align-items: center; gap: 5px;
}
.class-coord .cat-chip, .class-coord .seg-chip {
  font-size: 9.5px; padding: 2px 6px; border-radius: 5px;
  border: 1px solid var(--line); background: var(--surface-2); color: var(--muted);
}
.class-preview {
  position: relative; margin-top: 9px; height: 72px; border-radius: 8px;
  border: 1px dashed var(--line-strong); background: var(--surface);
  overflow: hidden;
}
.class-preview::before {
  content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(circle, var(--line) 1px, transparent 1.5px) 0 0 / 16px 16px;
  opacity: .5;
}
.class-dot {
  position: absolute; width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px;
  border-radius: 50%; background: var(--accent); border: 1.5px solid var(--surface);
  box-shadow: 0 0 0 2px rgba(198, 79, 42, .25);
}

/* ---------- 真截图抓到的排版问题：待采纳区吃掉主区高度 ----------
   CLIPBOARD 有 N 条时整块展开到 200px+，把下面的需求列表挤到只剩一行。
   限高 + 内部滚动：待采纳区固定占一小条，主体列表高度稳定。 */
html[data-app="prompter"] .prompt-pending {
  max-height: 176px;
  overflow: auto;
  flex: 0 0 auto;
}
/* ---------- 超量标红位：作为「位置已预留」默认要看得见 ----------
   原来 display:none 要等 .is-shown 才出现，导致这个预留位永远不可见。 */
html[data-app="prompter"] .tc-oversize {
  display: flex;
  opacity: .7;
  font-family: var(--mono);
  font-size: 9px;
}
html[data-app="prompter"][data-tc-slots="off"] .tc-oversize { display: none !important; }

/* ---------- 白天（原样）小字对比度修正 ----------
   真浏览器渲染值算出的 WCAG 结果：--faint #9AA4B4 在浅底上只有 2.39:1，
   --muted #6E788B 4.45:1 也差一点。这些是重排层新加的槽位，归本文件管，
   统一提到 --ink-soft #3E4759（约 9:1）。只作用于「原样」，两套深色皮肤
   有自己的 !important 覆盖，不受影响。 */
html[data-app="prompter"]:not([data-skin]) .tc-dock-slot,
html[data-app="prompter"]:not([data-skin]) .tc-slot-tag,
html[data-app="prompter"]:not([data-skin]) .tc-seg,
html[data-app="prompter"]:not([data-skin]) .tc-subtab,
html[data-app="prompter"]:not([data-skin]) .tc-light,
html[data-app="prompter"]:not([data-skin]) .tc-seg-note,
html[data-app="prompter"]:not([data-skin]) .tc-dock-ver,
html[data-app="prompter"]:not([data-skin]) .tc-groups-label,
html[data-app="prompter"]:not([data-skin]) .tc-segments-head,
html[data-app="prompter"]:not([data-skin]) .tc-dock-label,
html[data-app="prompter"]:not([data-skin]) .prompt-head-copy p { color: var(--ink-soft); }
html[data-app="prompter"]:not([data-skin]) .tc-view-btn.is-active,
html[data-app="prompter"]:not([data-skin]) .tc-group-btn.is-active { color: #A62B55; }
/* 预留位禁用态：提亮后不再叠加额外透明度，避免又压回去 */
html[data-app="prompter"]:not([data-skin]) .tc-view-btn:disabled,
html[data-app="prompter"]:not([data-skin]) .tc-group-btn:disabled { opacity: 1; color: var(--ink-soft); }

/* ===== 主人 2026-11-18：主页面重排——常驻工作台 + 项目大分区导航 ===== */
/* 常驻工作台：操作按钮从 header 移到左侧栏顶部，按操作环节就近固定 */
.tc-workbench { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
.tc-workbench .ghost-btn, .tc-workbench .primary-btn { width: 100%; justify-content: flex-start; text-align: left; }
.tc-workbench-sub { display: flex; gap: 6px; }
.tc-workbench-sub .ghost-btn { flex: 1 1 0; min-width: 0; font-size: 12px; padding: 5px 6px; justify-content: center; text-align: center; }

/* 主页面项目大分区导航：第一屏按项目看规则，单看/多选合并/看全部 */
.tc-mainprojnav { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 6px 16px 8px; }
.tc-mainprojnav-label { font-size: 11px; font-weight: 600; color: var(--ink-soft, var(--muted)); margin-right: 2px; }
.tc-mainprojnav-hint { font-size: 11px; color: var(--muted); margin-left: 4px; }
.tc-proj-chip { padding: 3px 9px; font-size: 12px; border-radius: 14px; cursor: pointer; }
.tc-proj-chip.is-active { border-color: var(--accent); color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); font-weight: 600; }
html[data-app="prompter"]:not([data-skin]) .tc-mainprojnav-label,
html[data-app="prompter"]:not([data-skin]) .tc-mainprojnav-hint { color: var(--ink-soft); }
