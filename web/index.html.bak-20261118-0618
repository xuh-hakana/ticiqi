<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>提词器 · 需求库</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2320242b'/%3E%3Cpath d='M9 11h14v14H9z' fill='%23c64f2a'/%3E%3Cpath d='M13 7h14v14' fill='none' stroke='%23e58d63' stroke-width='3'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/theme.css">
  <link rel="stylesheet" href="/night.css">
  <link rel="stylesheet" href="/layout-prompt.css">
  <link rel="stylesheet" href="/skin-nocturne.css">
  <link rel="stylesheet" href="/skin-cybercore.css">
</head>
<body>
  <svg class="sprite" aria-hidden="true" focusable="false">
    <symbol id="i-cube" viewBox="0 0 24 24"><path d="M12 2.8 21 7.5v9L12 21.2 3 16.5v-9L12 2.8Z"/><path d="m3.4 7.6 8.6 4.7 8.6-4.7M12 12.3v8.4"/></symbol>
    <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 7.5a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-10Z"/></symbol>
    <symbol id="i-folder-open" viewBox="0 0 24 24"><path d="M3 8V6.5a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2V10"/><path d="M4.3 10h16.2l-2.2 8.2a2 2 0 0 1-1.9 1.5H6.3a2 2 0 0 1-1.9-1.5L2.9 12a2 2 0 0 1 1.4-2Z"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24"><path d="M6.5 3.5h7l4 4v13h-11v-17Z"/><path d="M13.5 3.5v4h4"/></symbol>
    <symbol id="i-import" viewBox="0 0 24 24"><path d="M12 3v11M8 10l4-4 4 4M5 19h14"/></symbol>
    <symbol id="i-code" viewBox="0 0 24 24"><path d="m8.5 8-4 4 4 4M15.5 8l4 4-4 4M13.5 5l-3 14"/></symbol>
    <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z"/><path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20"/></symbol>
    <symbol id="i-braces" viewBox="0 0 24 24"><path d="M9 4H7a2 2 0 0 0-2 2v3.5L3.5 12 5 14.5V18a2 2 0 0 0 2 2h2M15 4h2a2 2 0 0 1 2 2v3.5l1.5 2.5-1.5 2.5V18a2 2 0 0 1-2 2h-2"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m15.5 15.5 4.3 4.3"/></symbol>
    <symbol id="i-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6"/></symbol>
    <symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
    <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.7l5.9-.9L12 3.5Z"/></symbol>
    <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 0-.8 5.2"/><path d="M20 4v7h-7"/></symbol>
    <symbol id="i-api" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12.5 4.3 4.3L19 7"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24"><path d="M12 3.5 21 20H3L12 3.5Z"/><path d="M12 9v5M12 17.2v.2"/></symbol>
    <symbol id="i-copy" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></symbol>
    <symbol id="i-close" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></symbol>
    <symbol id="i-grip" viewBox="0 0 24 24"><path d="M9 7h.01M15 7h.01M9 12h.01M15 12h.01M9 17h.01M15 17h.01" stroke-width="2.6"/></symbol>
    <symbol id="i-trash" viewBox="0 0 24 24"><path d="M4.5 6.5h15M9 6.5V4h6v2.5M7 6.5l.9 13.5h8.2l.9-13.5M10 10.5v6M14 10.5v6"/></symbol>
    <symbol id="i-pencil" viewBox="0 0 24 24"><path d="m4 20 4.2-1 10.6-10.6a2.1 2.1 0 0 0-3-3L5.2 16 4 20Z"/><path d="m14.3 6.9 3 3"/></symbol>
    <symbol id="i-arrow-left" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></symbol>
    <symbol id="i-layers" viewBox="0 0 24 24"><path d="m12 3 9 4.7-9 4.7-9-4.7L12 3Z"/><path d="m3 12.2 9 4.7 9-4.7M3 16.8l9 4.7 9-4.7"/></symbol>
    <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 20 6v6.3c0 4.4-3.3 7.4-8 8.7-4.7-1.3-8-4.3-8-8.7V6l8-3Z"/><path d="m8.5 12 2.3 2.3 4.7-4.8"/></symbol>
    <symbol id="i-terminal" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="m7 9 3.3 3L7 15M13 15h4"/></symbol>
    <symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></symbol>
    <symbol id="i-external" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-8.5 8.5"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></symbol>
    <symbol id="i-spark" viewBox="0 0 24 24"><path d="M12 3.5 13.7 9l5.5 1.7-5.5 1.7L12 18l-1.7-5.6L4.8 10.7 10.3 9 12 3.5Z"/><path d="M19 17.5v3M17.5 19h3"/></symbol>
    <symbol id="i-clip" viewBox="0 0 24 24"><rect x="5" y="4.5" width="14" height="16.5" rx="2"/><path d="M9 4.5V3.4a1.4 1.4 0 0 1 1.4-1.4h3.2A1.4 1.4 0 0 1 15 3.4v1.1"/><path d="M9 10h6M9 14h6M9 17.5h3.5"/></symbol>
    <symbol id="i-gauge" viewBox="0 0 24 24"><path d="M4 18a8 8 0 1 1 16 0"/><path d="m12 14 4-4"/><circle cx="12" cy="15" r="1.4"/></symbol>
    <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"/></symbol>
    <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/></symbol>
  </svg>

  <div class="app-shell">
    <header class="topbar">
      <div class="brand" aria-label="提词器">
        <span class="brand-mark" aria-hidden="true">
          <span class="brand-cube"></span>
        </span>
        <span class="brand-text">
          <strong>提词器</strong>
          <small>需求库 · 本地</small>
        </span>
      </div>

      <button class="root-chip" id="rootChip" type="button" title="切换文件夹">
        <svg class="icon"><use href="#i-folder-open"/></svg>
        <span class="root-chip-text">
          <span class="root-chip-label">工作区</span>
          <span class="root-chip-name" id="rootName">读取中…</span>
        </span>
        <svg class="icon root-chip-chevron"><use href="#i-chevron-down"/></svg>
      </button>

      <nav class="top-tabs" aria-label="主导航">
        <button class="top-tab is-active" id="tabFiles" type="button" data-view="files">
          <svg class="icon"><use href="#i-folder"/></svg>文件
        </button>
        <button class="top-tab" id="tabIndex" type="button" data-view="index">
          <svg class="icon"><use href="#i-layers"/></svg>功能索引
        </button>
        <button class="top-tab" id="tabPrompt" type="button" data-view="prompt">
          <svg class="icon"><use href="#i-spark"/></svg>提词器
        </button>
      </nav>

      <div class="top-actions">
        <button class="api-chip" id="apiChip" type="button" title="API 接入与状态">
          <span class="status-dot is-unchecked" id="apiDot"></span>
          <span id="apiChipText">API 未配置</span>
        </button>
        <button class="theme-btn" id="themeBtn" type="button" title="切换白天 / 夜晚模式">
          <svg class="icon theme-icon-night"><use href="#i-moon"/></svg>
          <svg class="icon theme-icon-day"><use href="#i-sun"/></svg>
          <span id="themeBtnText">夜晚</span>
        </button>
        <button class="theme-btn rain-tune-btn" id="rainTuneBtn" type="button"
                aria-expanded="false" aria-controls="rainTune"
                title="雨夜参数：晃动幅度、窗口模糊、窗口底色、窗外亮度、雨珠大小、雨量（只在夜晚出现）">
          <svg class="icon"><use href="#i-gauge"/></svg>
          <span>雨</span>
        </button>
        <button class="release-btn" id="releaseBtn" type="button" title="更新公告">
          <svg class="icon"><use href="#i-spark"/></svg>
          <span>更新公告</span>
          <span class="version-pill" id="versionPill">v0.1.0</span>
        </button>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar">
        <section class="pie-panel" id="piePanel" aria-label="大小占比">
          <div class="pie-head">
            <div class="pie-head-copy">
              <span class="eyebrow">SIZE MAP</span>
              <h2>大小占比</h2>
            </div>
            <span class="pie-flag" id="pieFlag" hidden><span class="pie-flag-dot"></span>有改动</span>
          </div>

          <div class="pie-modes" id="pieModes" role="group" aria-label="统计范围">
            <button class="pie-mode is-active" type="button" data-pie-mode="cur">当前</button>
            <button class="pie-mode" type="button" data-pie-mode="fav">收藏夹</button>
            <button class="pie-mode" type="button" data-pie-mode="drop" hidden>拖入</button>
          </div>

          <div class="pie-levels" id="pieLevels" role="group" aria-label="统计起点" hidden></div>

          <div class="pie-stage" id="pieStage">
            <svg class="pie-svg" id="pieSvg" viewBox="0 0 200 200" role="img" aria-label="文件大小占比环形图"></svg>
            <div class="pie-center" id="pieCenter"></div>
          </div>

          <div class="pie-trail" id="pieTrail"></div>
          <div class="pie-legend" id="pieLegend"></div>
          <p class="pie-hint" id="pieHint">把文件夹直接拖到这里，看它的大小占比</p>
        </section>

        <div class="sidebar-heading">
          <div>
            <span class="eyebrow">COLLECTIONS</span>
            <h2>收藏夹</h2>
          </div>
          <button class="icon-btn" id="addCategoryBtn" type="button" title="新建分类" aria-label="新建分类">
            <svg class="icon"><use href="#i-plus"/></svg>
          </button>
        </div>

        <div class="favorites-list" id="favoritesList" aria-live="polite"></div>

        <div class="sidebar-note">
          <svg class="icon"><use href="#i-shield"/></svg>
          <div>
            <strong>只读安全模式</strong>
            <span>不修改项目文件 · 跳过密钥、日志、缓存与构建产物 · 不跟随符号链接</span>
          </div>
        </div>
      </aside>

      <div class="col-grip" data-grip="1" role="separator" aria-orientation="vertical" tabindex="0" title="拖动调整收藏栏宽度"></div>

      <section class="explorer" aria-label="文件浏览">
        <div class="explorer-head">
          <div>
            <span class="eyebrow">WORKSPACE</span>
            <h2 id="workspaceTitle">文件</h2>
          </div>
          <button class="icon-btn" id="rescanBtn" type="button" title="重新扫描" aria-label="重新扫描">
            <svg class="icon"><use href="#i-refresh"/></svg>
          </button>
        </div>

        <div class="search-box" id="searchBox">
          <svg class="icon search-icon"><use href="#i-search"/></svg>
          <input id="fileSearch" type="search" placeholder="搜索文件或路径" autocomplete="off" spellcheck="false" aria-label="搜索文件或路径">
          <kbd class="search-kbd">⌘K</kbd>
          <button class="search-clear" id="searchClear" type="button" aria-label="清除搜索" hidden>
            <svg class="icon"><use href="#i-close"/></svg>
          </button>
        </div>

        <div class="filter-row" id="filterRow" role="group" aria-label="文件筛选">
          <button class="filter-chip is-active" type="button" data-kind="all">全部</button>
          <button class="filter-chip" type="button" data-kind="code">代码</button>
          <button class="filter-chip" type="button" data-kind="docs">文档</button>
          <button class="filter-chip" type="button" data-kind="config">配置</button>
          <button class="filter-chip" type="button" data-kind="other">其他</button>
          <span class="filter-spacer"></span>
          <button class="filter-chip filter-icon" id="newFilterBtn" type="button" title="只看新增文件" aria-label="只看新增文件">
            <span class="new-dot"></span>新增
          </button>
          <button class="filter-chip filter-icon" id="favFilterBtn" type="button" title="只看已收藏" aria-label="只看已收藏">
            <svg class="icon"><use href="#i-star"/></svg>
          </button>
        </div>

        <div class="scope-bar" id="scopeBar" hidden>
          <svg class="icon"><use href="#i-folder-open"/></svg>
          <span class="scope-label">目录</span>
          <span class="scope-path" id="scopePath"></span>
          <button class="scope-clear" id="scopeClear" type="button" aria-label="清除目录筛选">
            <svg class="icon"><use href="#i-close"/></svg>
          </button>
        </div>

        <div class="tree-scroll" id="treeScroll">
          <div class="file-tree" id="fileTree"></div>
          <div class="tree-empty" id="treeEmpty" hidden>
            <svg class="icon"><use href="#i-search"/></svg>
            <p>没有匹配的文件</p>
            <button class="text-btn" id="clearFiltersBtn" type="button">清除筛选</button>
          </div>
          <div class="tree-loading" id="treeLoading">
            <span class="skeleton-line"></span><span class="skeleton-line"></span><span class="skeleton-line"></span><span class="skeleton-line"></span>
          </div>
        </div>

        <div class="explorer-foot">
          <button class="new-jump" id="newJump" type="button" hidden>
            <span class="new-dot"></span><span id="newJumpText">0 个新增</span>
            <svg class="icon"><use href="#i-chevron"/></svg>
          </button>
          <span class="explorer-count" id="explorerCount">—</span>
        </div>
      </section>

      <div class="col-grip" data-grip="2" role="separator" aria-orientation="vertical" tabindex="0" title="拖动调整文件栏宽度"></div>

      <main class="main-pane" id="mainPane">
        <section class="welcome" id="welcome">
          <div class="welcome-grid">
            <div class="welcome-copy">
              <div class="welcome-badge"><span class="new-dot"></span> 本地运行 · 文件不出电脑</div>
              <h1>把项目，<br><em>摊开来看。</em></h1>
              <p class="welcome-lead">只读打开任意文件夹，在浏览器里读代码。收藏、检索、功能索引、引用自检与 API 状态，都放在同一张工作台上。</p>
              <div class="welcome-actions">
                <button class="primary-btn" id="openFolderBtn" type="button">
                  <svg class="icon"><use href="#i-folder-open"/></svg>打开文件夹
                </button>
                <button class="ghost-btn" id="welcomeIndexBtn" type="button">
                  <svg class="icon"><use href="#i-layers"/></svg>看看功能索引
                </button>
              </div>
              <p class="welcome-hint">快捷键 <kbd>⌘K</kbd> 搜索文件，<kbd>⌘B</kbd> 聚焦收藏夹</p>
            </div>

            <div class="welcome-board" aria-hidden="true">
              <div class="board-window">
                <div class="board-bar"><span></span><span></span><span></span><em>command-block / mirror</em></div>
                <div class="board-body">
                  <div class="board-side">
                    <span class="board-line short"></span><span class="board-line"></span><span class="board-line"></span>
                    <span class="board-line active"></span><span class="board-line short"></span>
                  </div>
                  <div class="board-code">
                    <span class="c1">const</span> <span class="c2">mirror</span> = <span class="c3">readOnly</span>(<span class="c4">folder</span>)<span class="p">;</span><br>
                    <span class="c1">await</span> <span class="c2">mirror</span>.<span class="c3">sync</span>()<span class="p">;</span><br><br>
                    <span class="c5">// 收藏、检索、索引</span><br>
                    <span class="c5">// 全部在一个页面里</span><br>
                    <span class="c1">return</span> <span class="c4">clarity</span><span class="p">;</span>
                  </div>
                </div>
              </div>
              <div class="board-card card-a"><svg class="icon"><use href="#i-layers"/></svg><span><strong id="welcomeFiles">—</strong><small>可见文件</small></span></div>
              <div class="board-card card-b"><svg class="icon"><use href="#i-shield"/></svg><span><strong>只读</strong><small>零写入</small></span></div>
              <div class="board-cube"><span></span></div>
            </div>
          </div>

          <div class="welcome-features">
            <article><span class="feature-no">01</span><svg class="icon"><use href="#i-folder-open"/></svg><h3>读取与查看</h3><p>指向文件夹即可浏览，语法高亮、行号与新增文件提示随扫描同步。</p></article>
            <article><span class="feature-no">02</span><svg class="icon"><use href="#i-star"/></svg><h3>可拖动收藏夹</h3><p>文件和文件夹都能拖进分类，分类与条目均可重新排序。</p></article>
            <article><span class="feature-no">03</span><svg class="icon"><use href="#i-layers"/></svg><h3>功能索引</h3><p>自动提取函数、类与 Markdown 小节，点击即可跳到源代码行。</p></article>
            <article><span class="feature-no">04</span><svg class="icon"><use href="#i-api"/></svg><h3>API 监测</h3><p>本机保存密钥，连接状态、延迟与模型可用性一目了然。</p></article>
          </div>

          <div class="welcome-foot">
            <span>v<span id="welcomeVersion">0.1.0</span> 本轮范围：读取 / 收藏夹 / API 入口 / 功能索引</span>
            <span>不含 AI 注解、Bug 检测、迁移执行</span>
          </div>
        </section>

        <section class="file-view" id="fileView" hidden>
          <div class="file-toolbar">
            <div class="breadcrumbs" id="fileCrumbs"></div>
            <div class="file-actions">
              <button class="subtle-btn" id="favFileBtn" type="button">
                <svg class="icon"><use href="#i-star"/></svg><span>收藏</span>
              </button>
              <button class="subtle-btn" id="reloadFileBtn" type="button" title="重新读取当前文件">
                <svg class="icon"><use href="#i-refresh"/></svg><span>刷新</span>
              </button>
            </div>
          </div>
          <div class="file-subbar">
            <span class="lang-pill" id="fileLang">CODE</span>
            <span id="fileMeta">—</span>
            <span class="readonly-pill"><svg class="icon"><use href="#i-shield"/></svg>只读</span>
            <span class="file-fullpath" id="filePath"></span>
          </div>
          <div class="file-notice" id="fileNotice" hidden></div>
          <div class="note-strip" id="noteStrip">
            <span class="note-badge" id="noteBadge">用途</span>
            <div class="note-body">
              <p class="note-text" id="noteText">还没有写这个文件是干什么的</p>
            </div>
            <button class="subtle-btn note-edit" id="noteEditBtn" type="button">
              <svg class="icon"><use href="#i-pencil"/></svg><span>写说明</span>
            </button>
          </div>
          <div class="code-wrap" id="codeWrap">
            <div class="code-scroll" id="codeScroll">
              <div class="code-lines" id="codeLines"></div>
            </div>
          </div>
          <div class="file-loading" id="fileLoading" hidden>
            <span class="skeleton-line"></span><span class="skeleton-line"></span><span class="skeleton-line"></span><span class="skeleton-line"></span><span class="skeleton-line short"></span>
          </div>
        </section>

        <section class="folder-view" id="folderView" hidden>
          <div class="folder-head">
            <div class="folder-icon"><svg class="icon"><use href="#i-folder-open"/></svg></div>
            <div class="folder-head-copy">
              <span class="eyebrow">FOLDER</span>
              <h1 id="folderTitle">文件夹</h1>
              <p id="folderMeta">—</p>
            </div>
            <button class="ghost-btn" id="folderScopeBtn" type="button">
              <svg class="icon"><use href="#i-search"/></svg>在文件栏筛选
            </button>
          </div>
          <div class="folder-list" id="folderList"></div>
        </section>

        <section class="index-view" id="indexView" hidden>
          <div class="index-head">
            <div>
              <span class="eyebrow">FEATURE INDEX</span>
              <h1>当前功能汇总</h1>
              <p>从可见代码中提取函数、类与 Markdown 小节。点击任意条目，直接跳到只读文件中的对应行。</p>
            </div>
            <button class="ghost-btn" id="indexRefreshBtn" type="button">
              <svg class="icon"><use href="#i-refresh"/></svg>重建索引
            </button>
          </div>
